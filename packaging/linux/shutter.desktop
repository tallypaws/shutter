[Desktop Entry]
Type=Application
Name=Shutter
Comment=Fast screenshot editor
TryExec=shutter
Exec=shutter
Icon=shutter
Terminal=false
Categories=Graphics;Utility;
Actions=Screenshot;
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2

[Desktop Action Screenshot]
Name=Take Screenshot
Exec=shutter --screenshot
Icon=shutter