pkgname=shutter
pkgver=$(tr -d '[:space:]' < "${startdir}/../../VERSION")
pkgrel=1

pkgdesc='screenshot editor'
url='https://github.com/tallypaws/shutter'
arch=('x86_64')
license=('PolyForm-Noncommercial-1.0.0')

depends=(
	'gtk3'
	'webkit2gtk-4.1'
)

optdepends=(
	'grim: capture on Hyprland, Sway, niri and other wlroots compositors'
	'xdg-desktop-portal: capture on GNOME and other desktops'
	'maim: capture on X11'
	'xdotool: capture the monitor under the mouse on X11'
	'wl-clipboard: clipboard support on Wayland'
	'xclip: clipboard support on X11'
	'gpu-screen-recorder: fast GPU-based capture'
)

# perl thingy has the naem and will kill my binary :(
conflicts=('shutter')

source=(
	'shutter'
	'shutter.desktop'
	'shutter.png'
)

sha256sums=(
	'SKIP'
	'SKIP'
	'SKIP'
)

package() {
	install -Dm755 \
		"$srcdir/shutter" \
		"$pkgdir/usr/bin/shutter"

	install -Dm644 \
		"$srcdir/shutter.desktop" \
		"$pkgdir/usr/share/applications/shutter.desktop"

	install -Dm644 \
		"$srcdir/shutter.png" \
		"$pkgdir/usr/share/icons/hicolor/512x512/apps/shutter.png"

	install -Dm644 \
		"$startdir/../../LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}